{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "agent-vitals",
  "version": "1.0.0-beta.1",
  "identifier": "com.mixlabpro.agent-vitals",
  "build": {
    "frontendDist": "ui",
    "beforeDevCommand": "npm --prefix ui-dev run dev",
    "devUrl": "http://127.0.0.1:5173/workbench.html"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "workbench",
        "title": "agent-vitals 工作台",
        "url": "workbench.html",
        "width": 760,
        "height": 560,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true,
        "visible": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "resources": {
      "../../../target/release/agent-vitals": "bin/agent-vitals"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "infoPlist": "Info.plist"
    }
  }
}
