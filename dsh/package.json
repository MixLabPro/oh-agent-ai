{
  "name": "dsh-skill-vitals",
  "version": "1.3.0",
  "description": "Skill Vitals as a DeepSeek Harness profile bundle: audits installed Agent Skills across hosts. Ships the skill instructions only — the scanner runs from PATH or a repo checkout, never from a bundled copy.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
