    "index.js",
    "cordis.patch.yml",
    "SKILL.md",
    "README.md"
  ],
  "keywords": [
    "skill-vitals",
    "skill",
    "audit",
    "dsh-plugin",
    "deepseek-harness"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MixLabPro/agent-vitals.git",
    "directory": "dsh"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
